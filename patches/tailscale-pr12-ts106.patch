+		if len(v6.conns) != 3 || v6.bound != 1 {
+			t.Fatal("expected one real IPv6 socket and two padded receive slots")
+		}
+		l.fail4.Store(true)
+		c.Rebind()
+		synctest.Wait()
+		v6 = c.pconn6.groupAtomic.Load()
+		failed := c.pconn4.groupAtomic.Load()
+		if failed.bound != 0 || len(failed.conns) != 3 {
+			t.Fatal("failed bind did not install a full placeholder group")
+		}
+		l.fail4.Store(false)
